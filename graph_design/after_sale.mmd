flowchart TD
    START([after_sale]) --> ROUTE{START 条件路由}

    ROUTE -->|refund 且缺少 order_id| ASK[request_refund_order_id]
    ASK --> END1([END])

    ROUTE -->|ticket / exchange / complaint| TICKET[create_ticket]
    TICKET --> END2([END])

    ROUTE -->|refund 且有 order_id| DRAFT[create_refund_draft]
    DRAFT --> DRAFT_ROUTE{_draft_route}

    DRAFT_ROUTE -->|失败| END3([END])
    DRAFT_ROUTE -->|user_confirm| USER{{interrupt: refund_confirmation}}
    DRAFT_ROUTE -->|已有 pending_supervisor| SUP{{interrupt: supervisor_approval}}

    USER -->|cancel| CANCEL[cancel_refund]
    USER -->|confirm| CONFIRM[confirm_refund]
    CANCEL --> END4([END])

    CONFIRM --> CONFIRM_ROUTE{_approval_route}
    CONFIRM_ROUTE -->|完成 / 失败 / 幂等| END5([END])
    CONFIRM_ROUTE -->|approval_required| SUP

    SUP --> RESUME[supervisor_resume]
    RESUME --> END6([END])

    ADMIN[管理员 API: approve_refund] -. 修改数据库并 resume .-> SUP