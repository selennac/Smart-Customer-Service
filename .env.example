# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Alibaba Cloud DashScope OpenAI-compatible endpoint
# DASHSCOPE_API_KEY is the provider's native name; LLM_API_KEY is what the app reads.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
LLM_API_KEY=replace-with-your-dashscope-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# PostgreSQL 16: business tables and LangGraph checkpoints
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_customer_service
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_customer_service

# Local Chroma persistence and source documents
CHROMA_PERSIST_DIRECTORY=./storage/chroma
KNOWLEDGE_BASE_PATH=./data/knowledge

# Frontend access during local development (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Demo authentication and workflow policy
JWT_SECRET_KEY=change-this-for-local-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFUND_APPROVAL_THRESHOLD=500
